# Committed base defaults. Non-secret. Loaded first, always.
# Values here assume the app runs INSIDE the Docker Compose network.
# See .env.example for what every variable means.

# --- Runtime ---
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

# --- Database ---
POSTGRES_DB=derq
POSTGRES_USER=derq
POSTGRES_PORT=5432
DATABASE_URL=postgres://derq:derq_local_dev@postgres:5432/derq
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=5000

# --- HTTP ---
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AGGREGATE_CACHE_MAX_AGE=60

# --- Seeding ---
SEED_DAYS=90
