# Committed local-development overrides. ONLY values that differ from .env.
# Loaded after .env, before .env.local.

NODE_ENV=development
LOG_LEVEL=debug

# The API runs on the host; Postgres is published from Compose on localhost.
DATABASE_URL=postgres://derq:derq_local_dev@localhost:5432/derq

# Vite dev server origin.
CORS_ORIGIN=http://localhost:5173

# Don't cache aggregates while developing — you want to see writes immediately.
AGGREGATE_CACHE_MAX_AGE=0
