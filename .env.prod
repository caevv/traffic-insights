# Committed production non-secret values, unquoted, standalone (NOT layered).
# Paste into the host's environment panel. Fill DATABASE_URL from the host's
# secret store — never commit a real credential to this file.

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

POSTGRES_DB=derq
POSTGRES_USER=derq
DATABASE_URL=
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=5000

CORS_ORIGIN=https://traffic.example.com
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
AGGREGATE_CACHE_MAX_AGE=60

SEED_DAYS=90
