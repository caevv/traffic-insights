# Local development overrides, committed. ONLY values that differ from .env.
# Loaded after .env and before .env.local.

NODE_ENV=development
LOG_LEVEL=debug

# The API runs on your machine, Postgres is published by Compose on localhost.
DATABASE_URL=postgres://derq:derq_local_dev@localhost:5432/derq

# The Vite dev server origin.
CORS_ORIGIN=http://localhost:5173

# No caching while developing, so you see your writes straight away.
AGGREGATE_CACHE_MAX_AGE=0
