# Production values for the API, no secrets, unquoted, standalone (NOT layered).
# Paste into your host's environment panel. Fill DATABASE_URL from the host's
# secret store. Never put a real password in this file.
#
# No POSTGRES_* here on purpose. Those configure the Compose Postgres
# container, which is a local convenience, not how this runs in production.
# In production the database is managed (RDS, Neon, Supabase) and
# DATABASE_URL is the whole interface to it.

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

DATABASE_URL=
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=5000

CORS_ORIGIN=https://traffic.example.com
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
AGGREGATE_CACHE_MAX_AGE=60

SEED_DAYS=90
