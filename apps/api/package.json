{
  "name": "@derq/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Traffic analytics API — Fastify 5 + PostgreSQL.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.dev --env-file-if-exists=../../.env.local --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.dev --env-file-if-exists=../../.env.local --import tsx src/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.dev --env-file-if-exists=../../.env.local --import tsx src/cli/seed.ts",
    "bench": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.dev --env-file-if-exists=../../.env.local --import tsx src/cli/bench.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.16.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autocannon": "^8.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
